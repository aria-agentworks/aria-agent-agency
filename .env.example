# ==============================================================================
# Aria Agent Agency — Environment Configuration
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=production

# Public site origin (used for canonical SEO, robots.txt, sitemap, and webhook redirects)
# When deploying, change this to your live domain (e.g., https://your-agency.onrender.com)
PUBLIC_SITE_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Dodo Payments (Merchant of Record - Cards, UPI, NetBanking, Subscriptions)
# ------------------------------------------------------------------------------
# Get your keys at: https://app.dodopayments.com (Developer -> API Keys & Webhooks)
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PAYMENTS_MODE=test_mode    # Use "test_mode" for sandbox, change to "live_mode" when launched
DODO_WEBHOOK_KEY=whsec_your_webhook_signing_key_here

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Auto-generated if omitted, but recommended to keep static across restarts
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string

# ------------------------------------------------------------------------------
# Optional Integrations
# ------------------------------------------------------------------------------
# If connecting custom AI models for the Growth Engine research crawler:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
