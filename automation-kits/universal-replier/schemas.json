{
  "input": {
    "type": "object",
    "required": [
      "correlation_id"
    ],
    "properties": {
      "correlation_id": {
        "type": "string"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "status",
      "review_required",
      "reason",
      "correlation_id"
    ],
    "properties": {
      "status": {
        "enum": [
          "READY",
          "NEEDS_HUMAN_REVIEW",
          "DRAFT_ONLY"
        ]
      },
      "review_required": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      },
      "correlation_id": {
        "type": "string"
      },
      "intent": {
        "enum": [
          "greeting",
          "booking",
          "pricing",
          "hours_location",
          "service_info",
          "order_status",
          "quote_request",
          "complaint",
          "human_request",
          "emergency",
          "other"
        ]
      },
      "reply": {
        "type": "string"
      },
      "needs_human": {
        "type": "boolean"
      },
      "action_draft": {
        "type": "object"
      }
    }
  },
  "kit": "universal-replier",
  "workflow_outputs": {
    "replier-intake": {
      "status": "DRAFT_ONLY|NEEDS_HUMAN_REVIEW",
      "intent": "string from the fixed intent set",
      "reply": "string draft using approved profile facts only",
      "needs_human": true,
      "reason": "string",
      "correlation_id": "string"
    },
    "replier-handover": {
      "status": "DRAFT_ONLY|NEEDS_HUMAN_REVIEW",
      "needs_human": true,
      "handover_package_draft": {
        "send_to": "profile handover contact",
        "urgency": "normal|high",
        "reason": "escalation reason",
        "transcript_summary": "string",
        "fields_collected": "object",
        "stop_replier": true
      },
      "correlation_id": "string"
    },
    "replier-booking": {
      "status": "DRAFT_ONLY|NEEDS_HUMAN_REVIEW",
      "booking_draft": {
        "offered_slots": "array of source-returned slot references only",
        "confirmation_draft": "string",
        "calendar_write": "not_performed_in_demo"
      },
      "correlation_id": "string"
    },
    "replier-followup": {
      "status": "DRAFT_ONLY|NEEDS_HUMAN_REVIEW",
      "followup_draft": {
        "template_used": "approved template id or none",
        "message_draft": "string",
        "send": "not_performed_in_demo"
      },
      "correlation_id": "string"
    }
  },
  "adapter_contract": "Return source-confirmed facts plus correlation_id and an explicit error state; never infer missing values, never send a draft, never write a booking without an approved adapter and human approval."
}
