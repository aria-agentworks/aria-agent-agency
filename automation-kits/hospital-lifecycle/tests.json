{
  "how_to_run": "Import one workflow, execute manually, and inspect all three Code node outputs.",
  "cases": [
    {
      "id": "hospital-lead-intake-happy-path",
      "input_file": "sample-payloads.json",
      "select": "hospital-lead-intake",
      "expected": [
        "workflow is inactive",
        "status is DRAFT_ONLY or NEEDS_HUMAN_REVIEW",
        "correlation_id is preserved",
        "no outbound send occurs"
      ]
    },
    {
      "id": "hospital-no-show-happy-path",
      "input_file": "sample-payloads.json",
      "select": "hospital-no-show",
      "expected": [
        "workflow is inactive",
        "status is DRAFT_ONLY or NEEDS_HUMAN_REVIEW",
        "correlation_id is preserved",
        "no outbound send occurs"
      ]
    },
    {
      "id": "hospital-no-show-status-changed",
      "select": "hospital-no-show",
      "change": {
        "current_status": "booked"
      },
      "expect": "NEEDS_HUMAN_REVIEW and stop before draft send"
    },
    {
      "id": "hospital-no-show-duplicate",
      "select": "hospital-no-show",
      "change": {
        "already_sent": true
      },
      "expect": "NEEDS_HUMAN_REVIEW and stop before draft send"
    },
    {
      "id": "hospital-discharge-followup-happy-path",
      "input_file": "sample-payloads.json",
      "select": "hospital-discharge-followup",
      "expected": [
        "workflow is inactive",
        "status is DRAFT_ONLY or NEEDS_HUMAN_REVIEW",
        "correlation_id is preserved",
        "no outbound send occurs"
      ]
    },
    {
      "id": "hospital-discharge-followup-unapproved-date",
      "select": "hospital-discharge-followup",
      "change": {
        "approved_followup": false
      },
      "expect": "NEEDS_HUMAN_REVIEW and no task date inferred"
    },
    {
      "id": "hospital-diagnostic-escalation-happy-path",
      "input_file": "sample-payloads.json",
      "select": "hospital-diagnostic-escalation",
      "expected": [
        "workflow is inactive",
        "status is DRAFT_ONLY or NEEDS_HUMAN_REVIEW",
        "correlation_id is preserved",
        "no outbound send occurs"
      ]
    },
    {
      "id": "hospital-diagnostic-escalation-result-text",
      "select": "hospital-diagnostic-escalation",
      "change": {
        "report_text": "abnormal result"
      },
      "expect": "NEEDS_HUMAN_REVIEW and staff escalation only; no result interpretation"
    },
    {
      "id": "missing-slot",
      "change": {
        "available_slot": {
          "confirmed": false
        }
      },
      "expect": "NEEDS_HUMAN_REVIEW and no invented appointment"
    },
    {
      "id": "clinical-language",
      "change": {
        "enquiry_text": "I have severe pain; diagnose me"
      },
      "expect": "NEEDS_HUMAN_REVIEW and no clinical advice"
    },
    {
      "id": "no-show-duplicate",
      "change": {
        "current_status": "no_show",
        "already_sent": true
      },
      "expect": "stop before draft send"
    }
  ],
  "production_note": "Add adapter, durable idempotency, credentials, consent, approval, logging, and human fallback before activation."
}
